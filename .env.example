# Copie para .env e ajuste. Todas as variáveis são opcionais.
# Também é possível usar um config.toml (mesmos nomes, sem o prefixo CLIPADOR_, em minúsculas).

# Pasta onde ficam banco, VODs, clips e temporários (caminho absoluto ou relativo à pasta do projeto)
CLIPADOR_DATA_DIR=data

# Servidor web
CLIPADOR_WEB_HOST=127.0.0.1
CLIPADOR_WEB_PORT=8000

# Worker: quantos jobs ao mesmo tempo (jobs de GPU são sempre 1 por vez)
CLIPADOR_WORKER_CONCURRENCY=2

# Ferramentas externas (deixe em branco para usar o que estiver no PATH)
CLIPADOR_FFMPEG_PATH=ffmpeg
CLIPADOR_FFPROBE_PATH=ffprobe
# Comando do yt-dlp. Vazio = usa o yt-dlp instalado no ambiente do projeto (python -m yt_dlp).
# Ex.: CLIPADOR_YTDLP_COMMAND=C:\tools\yt-dlp.exe
CLIPADOR_YTDLP_COMMAND=

# Resolução máxima do download
CLIPADOR_MAX_DOWNLOAD_HEIGHT=1080

# Cookies para YouTube/Kick quando exigirem login ou verificação (use só um dos dois)
# CLIPADOR_COOKIES_FROM_BROWSER=chrome
# CLIPADOR_COOKIES_FILE=C:\caminho\cookies.txt

# Transcrição (Whisper)
# CLIPADOR_WHISPER_MODEL=medium           # large-v3-turbo + int8_float16 é ~2x mais rápido
# CLIPADOR_WHISPER_COMPUTE_TYPE=float16   # int8_float16 se a VRAM apertar
# CLIPADOR_LANGUAGE=pt                    # ou auto
# CLIPADOR_TWITCH_DOWNLOADER_PATH=C:\tools\TwitchDownloaderCLI.exe

# IA local (Ollama, opcional)
CLIPADOR_OLLAMA_URL=http://localhost:11434
# CLIPADOR_LLM_MODEL=qwen2.5:7b
# CLIPADOR_TARGET_CLIPS=5                 # a IA avalia 3x isso
# CLIPADOR_LLM_NUM_CTX=6144
# CLIPADOR_RANK_WEIGHT_DETECT=0.5
# CLIPADOR_RANK_WEIGHT_LLM=0.5
# CLIPADOR_DEFAULT_GAME=GTA 6
